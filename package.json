{
  "name": "ai-eogul-court",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:demo": "cross-env AI_MODE=mock npm run dev",
    "build": "npm run build -w client && npm run build -w server",
    "start": "cross-env NODE_ENV=production npm run start -w server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke-production.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
