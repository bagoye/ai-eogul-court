# 이 파일을 .env로 복사해 값을 채웁니다. .env는 Git에 올라가지 않습니다.
# 실제 키·토큰은 이 예시 파일에 적지 마세요.

# 필수(실제 AI 사용 시). 서버 전용 비밀 값입니다.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low

# 개발 시에만 mock 허용
# AI_MODE=gemini
# PORT=3001
# CLIENT_PORT=5173
# APP_ORIGIN=http://localhost:5173
# TRUST_PROXY_HOPS=
# IP당 하루(한국 시간) 재판 접수 수. 프로덕션 기본 20, 개발은 제한 없음. 0이면 끔
# DAILY_TRIAL_LIMIT=

# 재판 저장소. URL과 토큰이 둘 다 있으면 Redis, 없으면 서버 메모리에 저장합니다.
# Vercel의 Upstash 연동은 KV_REST_API_* 이름으로 자동 주입합니다.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Upstash 콘솔에서 직접 만든 경우 이 이름도 사용할 수 있습니다.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
